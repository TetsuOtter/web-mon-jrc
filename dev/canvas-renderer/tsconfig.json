{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "./dist",
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/**/__tests__/**", "node_modules", "dist"]
}
