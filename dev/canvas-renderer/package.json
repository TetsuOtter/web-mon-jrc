{
	"name": "@web-mon-jrc/canvas-renderer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./objects": {
			"types": "./dist/objects/index.d.ts",
			"default": "./dist/objects/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		},
		"./contexts": {
			"types": "./dist/contexts/index.d.ts",
			"default": "./dist/contexts/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"bdfparser": "^2.2.5",
		"readlineiter": "^1.0.1"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.0.0",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.1.0",
		"@vitejs/plugin-react-swc": "3.5.0",
		"jsdom": "^26.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"typescript": "^5.2.2",
		"vite": "6.4.1",
		"vitest": "^3.1.1"
	}
}
