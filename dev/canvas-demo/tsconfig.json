{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		/* Bundler mode */
		"allowImportingTsExtensions": true,
		"noEmit": true,

		/* Path aliases for local packages (IDE support) */
		"baseUrl": ".",
		"paths": {
			"@web-mon-jrc/canvas-renderer": ["../canvas-renderer/src/index.ts"],
			"@web-mon-jrc/canvas-renderer/*": ["../canvas-renderer/src/*"]
		},
		"types": ["vite/client"]
	},
	"include": ["src"],
	"references": [
		{ "path": "../canvas-renderer" }
	]
}
