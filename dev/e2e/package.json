{
	"name": "@web-mon-jrc/e2e",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"tsc": "tsc --noEmit",
		"test": "bash ./run-e2e.sh test",
		"test:update": "bash ./run-e2e.sh update",
		"test:ui": "bash ./run-e2e.sh ui",
		"test:headed": "bash ./run-e2e.sh headed",
		"test:host": "playwright test",
		"test:update:host": "playwright test --update-snapshots",
		"test:ui:host": "playwright test --ui",
		"test:headed:host": "playwright test --headed",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.52.0",
		"@types/pngjs": "^6.0.5",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.29.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"pngjs": "^7.0.0",
		"typescript": "^5.2.2",
		"web-mon-jrc": "workspace:*"
	}
}
