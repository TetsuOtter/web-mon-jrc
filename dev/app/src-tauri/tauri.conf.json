{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "web-mon-native",
	"version": "0.0.1",
	"identifier": "dev.t0r.web-mon.native",
	"build": {
		"beforeDevCommand": "yarn dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "yarn build",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		},
		"longDescription": "",
		"macOS": {
			"entitlements": null,
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null
		},
		"linux": {
			"deb": {
				"depends": []
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "web-mon-native",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {}
}
