{
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always",
		"source.fixAll.tslint": "always",
		"source.fixAll.stylelint": "always",
		"source.removeUnused": "never"
	},
	"editor.formatOnSave": false,
	"editor.formatOnSaveMode": "file",
	"eslint.workingDirectories": [
		{
			"pattern": "./dev/app/**",
			"cwd": "${workspaceFolder}/dev/app"
		},
		{
			"pattern": "./dev/canvas-demo/**",
			"cwd": "${workspaceFolder}/dev/canvas-demo"
		},
		{
			"pattern": "./dev/canvas-renderer/**",
			"cwd": "${workspaceFolder}/dev/canvas-renderer"
		},
	]
}
